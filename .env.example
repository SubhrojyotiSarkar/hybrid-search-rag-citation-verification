# Copy this file to .env and fill in real values. Never commit .env.

# LLM provider: Google Gemini. Create a free API key at https://aistudio.google.com/apikey
# (no billing account needed for the free tier).
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-api-key-here
# gemini-3.8-flash has a free tier (checked 2026-10-13). Check
# https://ai.google.dev/gemini-api/docs/pricing before changing it: not every model is free.
GEMINI_MODEL=gemini-3.8-flash
# low | medium | high  (higher = more thorough, slower, uses more of the free quota)
GEMINI_THINKING_LEVEL=medium
# Output token limit per answer, including Gemini's thinking tokens
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=120

# Storage (relative paths resolve against the project root)
DATA_DIR=data
MAX_UPLOAD_MB=25

# Embeddings and chunking
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE_TOKENS=220
CHUNK_OVERLAP_TOKENS=40
EMBEDDING_BATCH_SIZE=32

# Retrieval: dense | bm25 | hybrid | hybrid_rerank (used for answers; the inspector can pick any)
RETRIEVAL_MODE=hybrid
# Passages sent to the LLM (formerly DENSE_TOP_K, which is still accepted)
RETRIEVAL_TOP_K=8
# Hybrid: candidates from each retriever before fusion, and the RRF constant k
HYBRID_CANDIDATES_PER_RETRIEVER=20
RRF_K=60
# BM25 term-frequency saturation (k1) and length normalization (b)
BM25_K1=1.5
BM25_B=0.75
# Cross-encoder reranking (RETRIEVAL_MODE=hybrid_rerank). Candidates rescored per query:
# more = better recall, proportionally more latency (~20-30 ms per candidate on CPU).
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=30
RERANKER_BATCH_SIZE=32

# Citation verification: an independent LLM call checks every claim against its cited
# passages (1 extra call per answer; each recovery attempt adds 2 more).
VERIFICATION_ENABLED=true
# Regenerate with more evidence and the verifier's feedback at most this many times (0-2)
MAX_RECOVERY_ATTEMPTS=1
RECOVERY_TOP_K=12
# remove: drop unsupported claims from the answer (listed separately); flag: keep and mark them
UNSUPPORTED_CLAIM_POLICY=remove
VERIFICATION_MAX_CLAIMS_PER_CALL=10

# Evaluation: dataset, runs and human reviews; answer runs are paced to this request rate
EVALUATION_DIR=evaluation
EVAL_REQUESTS_PER_MINUTE=5

# Login. Keep false only for local use on your own machine; set true before exposing the
# app anywhere (e.g. a cloud server). With true, the backend refuses to start unless the
# secret key is set and at least one admin exists:
#   python -m backend.auth_admin generate-secret
#   python -m backend.auth_admin add-user <name> --role admin     (or --role viewer)
AUTH_ENABLED=false
AUTH_SECRET_KEY=
# Login sessions last this long (minutes); changing AUTH_SECRET_KEY logs everyone out
AUTH_TOKEN_TTL_MINUTES=480
# Accounts (password hashes only); defaults to <DATA_DIR>/users.json, which is gitignored
# AUTH_USERS_FILE=

# Logging: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Frontend -> backend for local runs. PUBLIC_BACKEND_URL is what the browser uses for
# "open PDF" links. (Docker ignores both: docker-compose.yml routes everything via the proxy.)
BACKEND_URL=http://127.0.0.1:8000
PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Docker only: the public address served by the proxy. A domain (rag.example.com) gets
# automatic HTTPS; ":80" (default) is plain HTTP for local testing. See docs/deploy-aws.md.
SITE_ADDRESS=:80
