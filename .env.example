# Copy this file to .env and fill in real values. Never commit .env.

# LLM provider: Google Gemini. Create a free API key at https://aistudio.google.com/apikey
# (no billing account needed for the free tier).
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-api-key-here
# gemini-3.8-flash has a free tier (checked 2026-10-13). Check
# https://ai.google.dev/gemini-api/docs/pricing before changing it: not every model is free.
GEMINI_MODEL=gemini-3.8-flash
# low | medium | high  (higher = more thorough, slower, uses more of the free quota)
GEMINI_THINKING_LEVEL=medium
# Output token limit per answer, including Gemini's thinking tokens
LLM_MAX_TOKENS=16000
LLM_TIMEOUT_SECONDS=120

# Storage (relative paths resolve against the project root)
DATA_DIR=data
MAX_UPLOAD_MB=25

# Embeddings and chunking
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE_TOKENS=220
CHUNK_OVERLAP_TOKENS=40
EMBEDDING_BATCH_SIZE=32

# Retrieval: dense | bm25 | hybrid | hybrid_rerank (used for answers; the inspector can pick any)
RETRIEVAL_MODE=hybrid
# Passages sent to the LLM (formerly DENSE_TOP_K, which is still accepted)
RETRIEVAL_TOP_K=8
# Hybrid: candidates from each retriever before fusion, and the RRF constant k
HYBRID_CANDIDATES_PER_RETRIEVER=20
RRF_K=60
# BM25 term-frequency saturation (k1) and length normalization (b)
BM25_K1=1.5
BM25_B=0.75
# Cross-encoder reranking (RETRIEVAL_MODE=hybrid_rerank). Candidates rescored per query:
# more = better recall, proportionally more latency (~20-30 ms per candidate on CPU).
RERANKER_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=30
RERANKER_BATCH_SIZE=32

# Frontend -> backend
BACKEND_URL=http://127.0.0.1:8000
